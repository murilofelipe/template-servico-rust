#!/usr/bin/env bash
#
# pre-push hook: Runs format, lint, audit, and tests before pushing to remote.
# Prevents pushing broken code.

echo "=========================================="
echo "🚀 Executando validações locais (Shift Left)..."
echo "=========================================="

export PATH="$HOME/.cargo/bin:$PATH"

if ! command -v cargo-audit &> /dev/null
then
    echo "📦 cargo-audit não encontrado. Instalando localmente..."
    cargo install cargo-audit
fi

# Variável para sqlx rodar offline nos testes (se aplicável futuramente)
export SQLX_OFFLINE=true

echo "🐳 Subindo banco de dados de testes via docker compose..."
docker compose up -d db

# Aguarda o banco ficar pronto
echo "⏳ Aguardando PostgreSQL aceitar conexões..."
sleep 3

# Run the 'check' target from Makefile
make check

# Capture the exit code
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "=========================================="
    echo "❌ FALHA: Validações locais (pre-push) falharam."
    echo "⚠️  O push foi abortado. Corrija os erros acima antes de tentar novamente."
    echo "=========================================="
    exit 1
fi

echo "✅ Sucesso! Código formatado, testado e seguro. Prosseguindo com o push..."
exit 0
